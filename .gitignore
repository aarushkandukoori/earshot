*.mlmodelc/
*.onnx
*.safetensors

# Raw measurement files pulled off the phone (`make phase0`). They can hold Bluetooth port ids,
# so only hand-written summaries in docs/measurements/*.md are committed.
docs/measurements/*
!docs/measurements/*.md

# Xcode / build
build/
engine/build/
DerivedData/
*.dSYM/
*.xcuserstate
xcuserdata/

# Personal signing and device settings (ios/local.mk, see ios/Makefile)
ios/local.mk
ios/.device
*.local.xcconfig

# macOS
.DS_Store

# Downloaded model weights (large, re-fetchable; WeSpeaker = VoxCeleb research terms)
models/
